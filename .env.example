# Leave DATABASE_URL unset to use the zero-setup SQLite database at var/cabos.db.
# DATABASE_URL=postgresql+psycopg://cabos:cabos@localhost:5432/cabos
CABOS_DEMO_MODE=true
CABOS_WEB_ORIGIN=http://localhost:3100
# Optional language providers (ADR-017). With no key, the deterministic template provider is used.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
